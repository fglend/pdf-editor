{
  "name": "pdf-editor",
  "version": "1.0.0",
  "description": "A simple, modern PDF editor — React, PDF.js, Fabric.js, pdf-lib, Node.js",
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,cyan \"vite\" \"node --watch server/index.js\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "express": "^4.22.3",
    "fabric": "^6.9.1",
    "lucide-react": "^1.73.0",
    "multer": "^1.4.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "vite": "^5.4.21"
  }
}
